# Terminux Configuration

# Google AI Studio API Key (Get one at https://aistudio.google.com/)
TERMINUX_GEMINI_API_KEY=your_api_key_here

# Embedding Backend: 'hash' or 'gemini'
# Note: 'gemini' requires an API key and provides much better semantic search.
TERMINUX_EMBEDDING_BACKEND=gemini
TERMINUX_EMBEDDING_DIM=768

# API URL (Where the backend is running)
TERMINUX_API_URL=http://127.0.0.1:8000

# Database & Storage
TERMINUX_SQLITE_PATH=./backend/data/terminux.db
TERMINUX_QDRANT_ENABLED=true
TERMINUX_QDRANT_URL=http://127.0.0.1:6333
TERMINUX_QDRANT_COLLECTION=terminux_memory

# Session Logic
TERMINUX_SESSION_GAP_SECONDS=1200
TERMINUX_RECALL_DEFAULT_LIMIT=5
